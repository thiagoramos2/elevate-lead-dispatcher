# Copie para .env para desenvolver localmente fora do Docker. Nunca commite o .env.
# Todos os valores abaixo são de demonstração local, não são segredos.

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://elevate:elevate@localhost:5432/elevate
REDIS_URL=redis://localhost:6379

API_PORT=3001
# Origens autorizadas a chamar rotas autenticadas que alteram dados (checagem de Origin contra CSRF).
APP_ORIGIN=http://localhost:3000
# Fuso horário usado em "leads hoje".
REPORTING_TIMEZONE=America/Sao_Paulo

# Segredos HMAC por call center, pares "slug:segredo" separados por vírgula (mínimo de 32 caracteres cada).
CALLCENTER_WEBHOOK_SECRETS=callcenter-a:dev-secret-a-0123456789abcdef0123456789,callcenter-b:dev-secret-b-0123456789abcdef0123456789,callcenter-c:dev-secret-c-0123456789abcdef0123456789

# Usuários de demonstração criados pelo seed.
SEED_ADMIN_PASSWORD=Elevate-Admin-2026
SEED_OPERATOR_PASSWORD=Elevate-Operator-2026
