# Copy to .env for local development outside Docker. Never commit .env.
# All values below are local demo values, not secrets.

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://elevate:elevate@localhost:5432/elevate
REDIS_URL=redis://localhost:6379

API_PORT=3001
# Origins allowed to call mutating authenticated routes (CSRF Origin check).
APP_ORIGIN=http://localhost:3000
# Timezone used for "leads today".
REPORTING_TIMEZONE=America/Sao_Paulo

# HMAC secrets per call center, "slug:secret" pairs separated by commas (min 32 chars each).
CALLCENTER_WEBHOOK_SECRETS=callcenter-a:dev-secret-a-0123456789abcdef0123456789,callcenter-b:dev-secret-b-0123456789abcdef0123456789,callcenter-c:dev-secret-c-0123456789abcdef0123456789

# Demo users created by the seed.
SEED_ADMIN_PASSWORD=Admin#Demo2026
SEED_OPERATOR_PASSWORD=Operator#Demo2026
